# ODDIUM V12 — 5Dollar Engine
DISCORD_TOKEN=
GUILD_ID=

# Source principale. Clé Pro 5DollarFootballAPI.
FIVE_DOLLAR_FOOTBALL_API_KEY=
FIVE_DOLLAR_POLL_SECONDS=45
FIVE_DOLLAR_FIXTURES_CACHE_SECONDS=900

# Secours calendrier/classements gratuit (optionnel mais recommandé)
FOOTBALL_DATA_API_KEY=

# Anciens providers : optionnels uniquement pour compatibilité/fallback
PROPLINE_API_KEY=
USE_PROPLINE_ODDS=false
API_FOOTBALL_KEY=
RAPIDAPI_KEY=

DB_PATH=data/oddium.db
BACKUP_DIR=data/backups
LOG_DIR=logs
API_CACHE_DIR=data/api_cache

CURRENCY_NAME=Gold
STARTING_BALANCE=5000
MIN_STAKE=10
MAX_STAKE=5000
MAX_STAKE_BALANCE_PERCENT=100
ALLOW_MULTIPLE_BETS_SAME_EVENT=true
LOCK_SECONDS_BEFORE_KICKOFF=60

# Live Discord. 5Dollar est interrogé toutes les 45s par défaut ; les fallbacks
# gratuits peuvent scanner plus vite grâce à leurs propres caches.
LIVE_POLL_SECONDS=5
LIVE_DISCOVERY_SECONDS=15
LIVE_PANEL_LOOKBACK_MINUTES=210
LIVE_PANEL_LOOKAHEAD_MINUTES=20
LIVE_FINISHED_DISPLAY_MINUTES=5
LIVE_WS_HOST=127.0.0.1
LIVE_WS_PORT=8765
LIVE_WS_PATH=/live

EVENTS_REFRESH_SECONDS=21600
ODDS_REFRESH_FAR_SECONDS=3600
ODDS_REFRESH_NEAR_SECONDS=1800
ODDS_REFRESH_HOT_SECONDS=900
ODDS_HORIZON_HOURS=168
ODDIUM_ODDS_MARGIN_PERCENT=6
MARKET_MODEL_ENABLED=true
MARKET_MODEL_HISTORY_YEARS=6

PANEL_REFRESH_SECONDS=60
ENGINE_TICK_SECONDS=60
BACKUP_EVERY_HOURS=6
BACKUP_KEEP_COUNT=20
DM_NOTIFICATIONS_DEFAULT=true
NOTIFY_BEFORE_MINUTES=30
